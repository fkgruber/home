<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>My Cookbook</title>

<style>
#authBox { display:none; margin-bottom:20px; }

body {
    font-family: Arial, sans-serif;
    max-width: 1000px;
    margin:auto;
    padding:20px;
}

.section {
    margin-bottom:40px;
    border-bottom:3px solid #ccc;
}

.section-header {
    cursor:pointer;
    background:#f3f3f3;
    padding:10px;
    font-size:22px;
}

.section-header:hover { background:#e0e0e0; }

.recipe { margin:20px 0; padding-left:20px; }

.hidden { display:none; }

.qty-input { width:70px; }

#searchInput {
    width:100%;
    padding:10px;
    margin-bottom:15px;
    font-size:16px;
}

#filters { margin-bottom:20px; }

.filter-btn {
    margin-right:10px;
    padding:6px 12px;
    cursor:pointer;
}

.edit-controls button { margin-right:8px; }
</style>
</head>

<body>

<h1>My Cookbook</h1>

<div id="authBox">
    <h2>Login</h2>
    <input id="username" placeholder="Username">
    <input id="password" type="password" placeholder="Password">
    <button onclick="login()">Login</button>
</div>

<input type="text" id="searchInput" placeholder="Search recipes...">

<div id="filters"></div>
<div id="recipes"></div>

<script>

let recipesData = [];
let activeSectionFilter = null;

// ---------------- LOGIN ----------------
async function login() {

    const username = document.getElementById("username").value;
    const password = document.getElementById("password").value;

    const res = await fetch("/api/login", {
        method:"POST",
        headers:{ "Content-Type":"application/json" },
        body: JSON.stringify({ username, password })
    });

    const data = await res.json();

    if (data.success) location.reload();
    else alert(data.error);
}

// ---------------- FETCH RECIPES ----------------
fetch("/api/recipes")
.then(res => {
    if (res.status === 401) {
        document.getElementById("authBox").style.display = "block";
        throw new Error("Unauthorized");
    }
    return res.json();
})
.then(data => {
    document.getElementById("authBox").style.display = "none";
    recipesData = data;
    renderFilters();
    renderAll();
})
.catch(()=>{});

// ---------------- FILTERS ----------------
function renderFilters() {

    const filterContainer = document.getElementById("filters");
    filterContainer.innerHTML = "";

    const sections = [...new Set(recipesData.map(r => r.section))];

    const allBtn = document.createElement("button");
    allBtn.textContent = "All";
    allBtn.className = "filter-btn";
    allBtn.onclick = () => {
        activeSectionFilter = null;
        renderAll(searchInput.value);
    };
    filterContainer.appendChild(allBtn);

    sections.forEach(section => {
        const btn = document.createElement("button");
        btn.textContent = section;
        btn.className = "filter-btn";
        btn.onclick = () => {
            activeSectionFilter = section;
            renderAll(searchInput.value);
        };
        filterContainer.appendChild(btn);
    });
}

// ---------------- RENDER ALL ----------------
function renderAll(searchText="") {

    const container = document.getElementById("recipes");
    container.innerHTML = "";

    const search = searchText.toLowerCase();

    const filtered = recipesData.filter(recipe => {

        if (activeSectionFilter && recipe.section !== activeSectionFilter)
            return false;

        if (!search) return true;

        const combined = `
            ${recipe.title}
            ${recipe.section}
            ${recipe.ingredients.map(i=>i.name).join(" ")}
            ${recipe.directions.join(" ")}
        `.toLowerCase();

        return combined.includes(search);
    });

    const grouped = {};
    filtered.forEach(r=>{
        if(!grouped[r.section]) grouped[r.section]=[];
        grouped[r.section].push(r);
    });

    Object.keys(grouped).forEach(section=>{

        const sectionDiv = document.createElement("div");
        sectionDiv.className="section";

        const header = document.createElement("div");
        header.className="section-header";
        header.textContent=section;

        const wrapper = document.createElement("div");
        header.onclick = ()=>wrapper.classList.toggle("hidden");

        grouped[section].forEach(recipe=>{
            wrapper.appendChild(renderRecipe(recipe));
        });

        sectionDiv.appendChild(header);
        sectionDiv.appendChild(wrapper);
        container.appendChild(sectionDiv);
    });
}

// ---------------- RENDER RECIPE ----------------
function renderRecipe(recipe){

    const wrapper = document.createElement("div");
    wrapper.className="recipe";

    const baseIngredients = JSON.parse(JSON.stringify(recipe.ingredients));
    let current = JSON.parse(JSON.stringify(recipe.ingredients));
    let scaleFactor = 1;
    let isEditMode = false;

    wrapper.innerHTML = `
        <h3 class="recipe-title">${recipe.title}</h3>

        <div class="edit-controls">
            <button class="edit-btn">Edit</button>
            <button class="save-btn hidden">Save</button>
            <button class="cancel-btn hidden">Cancel</button>
        </div>

        <h4>Ingredients</h4>
        <ul class="ingredients"></ul>

        <h4>Directions</h4>
        <ol class="directions">
            ${recipe.directions.map(d=>`<li>${d}</li>`).join("")}
        </ol>
    `;

    const list = wrapper.querySelector(".ingredients");

    function renderIngredients(){
        list.innerHTML="";

        current.forEach((i,index)=>{

            const li=document.createElement("li");

            if(!i.scalable){
                li.textContent=i.name;
            } else {
                li.innerHTML=`
                    <input class="qty-input"
                        type="number"
                        step="0.25"
                        value="${i.qty}"
                        data-index="${index}">
                    ${i.unit||""} ${i.name}
                `;
            }

            list.appendChild(li);
        });

        attachScaling();
    }

    function attachScaling(){

        if(isEditMode) return;

        wrapper.querySelectorAll(".qty-input").forEach(input=>{
            input.onchange=e=>{
                const idx=parseInt(e.target.dataset.index);
                const newQty=parseFloat(e.target.value);
                if(!newQty || newQty<=0) return;

                scaleFactor=newQty/baseIngredients[idx].qty;

                current=baseIngredients.map(i=>
                    i.scalable
                        ? {...i, qty: i.qty*scaleFactor}
                        : i
                );

                renderIngredients();
            };
        });
    }

    renderIngredients();

    const editBtn=wrapper.querySelector(".edit-btn");
    const saveBtn=wrapper.querySelector(".save-btn");
    const cancelBtn=wrapper.querySelector(".cancel-btn");
    const titleEl=wrapper.querySelector(".recipe-title");

    editBtn.onclick=()=>{

        current=current.map((i,idx)=>
            i.scalable
                ? {...i, qty:i.qty/scaleFactor}
                : i
        );

        scaleFactor=1;
        isEditMode=true;

        titleEl.contentEditable=true;
        wrapper.querySelectorAll(".directions li")
            .forEach(li=>li.contentEditable=true);

        editBtn.classList.add("hidden");
        saveBtn.classList.remove("hidden");
        cancelBtn.classList.remove("hidden");

        renderIngredients();
    };

    cancelBtn.onclick=()=>location.reload();

    saveBtn.onclick=async()=>{

        const newTitle=titleEl.innerText.trim();

        const newIngredients=[];
        wrapper.querySelectorAll(".ingredients li").forEach(li=>{
            const input=li.querySelector("input");
            if(input){
                newIngredients.push({
                    qty:parseFloat(input.value),
                    unit:"",
                    name:li.innerText.replace(input.value,"").trim(),
                    scalable:true
                });
            } else {
                newIngredients.push({
                    name:li.innerText,
                    scalable:false
                });
            }
        });

        const newDirections=[];
        wrapper.querySelectorAll(".directions li")
            .forEach(li=>newDirections.push(li.innerText.trim()));

        await fetch(`/api/recipe/${recipe.id}`,{
            method:"POST",
            headers:{ "Content-Type":"application/json" },
            body:JSON.stringify({
                title:newTitle,
                section:recipe.section,
                ingredients:newIngredients,
                directions:newDirections
            })
        });

        alert("Saved!");
        location.reload();
    };

    return wrapper;
}

// ---------------- FRACTION FORMAT ----------------
function formatQty(num){

    const fractions={
        0.25:"¼",
        0.5:"½",
        0.75:"¾",
        0.33:"⅓",
        0.66:"⅔"
    };

    const whole=Math.floor(num);
    const decimal=+(num-whole).toFixed(2);

    if(decimal===0) return whole;

    if(fractions[decimal])
        return whole?`${whole} ${fractions[decimal]}`:fractions[decimal];

    return parseFloat(num.toFixed(3));
}

// ---------------- SEARCH ----------------
document.getElementById("searchInput")
.addEventListener("input",e=>{
    renderAll(e.target.value);
});

</script>
</body>
</html>
