@article{mikej.masonMultipleMyelomaDREAM2020,
  title = {Multiple {{Myeloma DREAM Challenge}} Reveals Epigenetic Regulator {{PHF19}} as Marker of Aggressive Disease},
  author = {{Mike J. Mason} and {Carolina Schinke} and {Christine L. P. Eng} and {Fadi Towfic} and {Fred Gruber} and {Andrew Dervan} and {Brian S. White} and {Aditya Pratapa} and {Yuanfang Guan} and {Hongjie Chen} and {Yi Cui} and {Bailiang Li} and {Thomas Yu} and {Elias Chaibub Neto} and {Konstantinos Mavrommatis} and {Maria Ortiz} and {Valeriy Lyzogubov} and {Kamlesh Bisht} and {Hongyue Y. Dai} and {Frank Schmitz} and {Erin Flynt} and {Dan Rozelle} and {Samuel A. Danziger} and {Alexander Ratushny} and {William S. Dalton} and {Hartmut Goldschmidt} and {Herve Avet-Loiseau} and {Mehmet Samur} and {Boris Hayete} and Sonneveld, Pieter and {Kenneth H. Shain} and {Nikhil Munshi} and {Daniel Auclair} and {Dirk Hose} and {Gareth Morgan} and {Matthew Trotter} and {Douglas Bassett} and {Jonathan Goke} and {Brian A. Walker} and {Anjan Thakurta} and {Justin Guinney}},
  year = {2020},
  month = feb,
  journal = {Leukemia},
  pages = {1--9},
  issn = {1476-5551},
  doi = {10.1038/s41375-020-0742-z},
  url = {https://www.nature.com/articles/s41375-020-0742-z},
  urldate = {2020-02-17},
  abstract = {While the past decade has seen meaningful improvements in clinical outcomes for multiple myeloma patients, a subset of patients does not benefit from current therapeutics for unclear reasons. Many gene expression-based models of risk have been developed, but each model uses a different combination of genes and often involves assaying many genes making them difficult to implement. We organized the Multiple Myeloma DREAM Challenge, a crowdsourced effort to develop models of rapid progression in newly diagnosed myeloma patients and to benchmark these against previously published models. This effort lead to more robust predictors and found that incorporating specific demographic and clinical features improved gene expression-based models of high risk. Furthermore, post-challenge analysis identified a novel expression-based risk marker, PHF19, which has recently been found to have an important biological role in multiple myeloma. Lastly, we show that a simple four feature predictor composed of age, ISS, and expression of PHF19 and MMSET performs similarly to more complex models with many more gene expression features included.},
  copyright = {2020 The Author(s)},
  langid = {english},
  file = {/Users/fred/Zotero/storage/6EJFQIQ3/Mason et al_2020_Multiple Myeloma DREAM Challenge reveals epigenetic regulator PHF19 as marker.pdf;/Users/fred/Zotero/storage/AXBGRSXR/s41375-020-0742-z.html}
}
