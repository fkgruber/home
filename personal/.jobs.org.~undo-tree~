** Question

Here I'm assuming that we have 34 vials and different number of balls that are randomly assigned to a vial. There can be only 1 ball per vial at most. Then I just sequentially group the vials for joint obsevation with no overlap.
It appears that there is an optimal number of grouping of the vials to reduce the number of observations but it depends on how many balls there are.

If there is 1 ball then you need to group them by 5. with 3 balls you need to group them by 10. If there are too many balls then is bettern not to group them at all.


#+begin_src R
N=34 ##vial
allvials=1:N
Nrep=200 ## number of replicates

res=map_df(seq(1,17,by=2),
       function(pp){
         p=pp ## balls
         map_df(1:Nrep,
                    function(rr)L{
                      assign=sample(1:N,p,replace=F) ## assignment of balls to vials
                      vials=ifelse(allvials %in%
                                   assign,1,0) %>% set_names(allvials)
                      allgrp=map_df(1:N,
                                    function(gg){
                                      group=gg
                                      group_assign=rep(1:group,length.out=N)
                                      nobs=0
                                      for(ii in 1:group){
                                        nobs=nobs+1
                                        if(sum(vials[group_assign==ii])>0){
                                          nobs=nobs+length(vials[group_assign==ii])
                                        }
                                      }
                                      tibble(Group_by=gg,Nobs=nobs,Rep=rr,p=pp)
                                    })
                    })
       })


res %>%
  ggplot(aes(x=Group_by,y=Nobs))+
  geom_jitter(alpha=0.01)+
  geom_line(data=res %>%
            group_by(Group_by,p) %>%
            summarise(Nobs=mean(Nobs)),colour=\"orange\",linewidth=1.2)+
  theme_light()+
  facet_wrap(~p,labeller=label_both)



#+end_src

